{
  "name": "novel-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "generate:wiki-index": "node ./scripts/generate-wiki-index.mjs",
    "build": "npm run copy-novel-md && npm run generate:content-index && npm run generate:wiki-index && next build",
    "start": "next start",
    "lint": "next lint",
    "sync:content": "node ./scripts/sync-content-repo.mjs",
    "generate:content-index": "node ./scripts/generate-content-index.mjs",
    "copy-novel-md": "node ./scripts/copy-novel-markdown-to-public.mjs",
    "diag:content": "node ./scripts/diagnose-content.mjs",
    "preview": "npm run sync:content && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run sync:content && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-build": "npm run sync:content && npm run generate:content-index && npm run generate:wiki-index && npm run diag:content && npm run copy-novel-md && opennextjs-cloudflare build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "next": "^15.5.15",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.17.17",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.15",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wrangler": "^4.85.0"
  }
}
