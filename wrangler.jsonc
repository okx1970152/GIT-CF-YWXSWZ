{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novel-portal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Worker 运行时明文变量（与 GitHub Actions Variables 对齐；部署时写入 CF 项目）
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://wx.0o0o.mom",
    "APP_GITHUB_REPO": "okx1970152/GIT-CF-YWXSWZ",
    "APP_GITHUB_BRANCH": "main",
    "APP_GITHUB_ADS_PATH": "data/ads.json"
  },
  "kv_namespaces": [
    {
      "binding": "SITE_STATS_KV",
      "id": "ef37b15f5dd7490c9865c6d4fa3bd78d",
      "preview_id": "f5f39d834c1e4ea59b419651a2743e11"
    }
  ]
}
